# --- FastAPI ordering backend -------------------------------------------------
# Same PostgreSQL database the Next.js app uses. libpq params (sslmode, schema,
# pgbouncer) are understood and translated for asyncpg automatically.
DATABASE_URL="postgresql://relaydesk:relaydesk@localhost:5544/relaydesk?schema=public"

# Separate database used by the pytest suite (it is wiped between tests).
API_TEST_DATABASE_URL="postgresql://relaydesk:relaydesk@localhost:5544/relaydesk_api_test?schema=public"

# Public base URL of the web app, used to build customer invitation links.
APP_URL="http://localhost:3000"

# Cross-origin callers (mobile). Web uses a same-origin Next rewrite and needs
# no entry here. Use a comma-separated list in production; "*" is dev-only and
# disables credentialed CORS.
CORS_ORIGINS="*"

# "production" switches admin cookie name to __Host-bl_session (matches the web app).
ENVIRONMENT="development"

# Session/token lifetimes (days).
ADMIN_SESSION_TTL_DAYS=30
CUSTOMER_SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=14
